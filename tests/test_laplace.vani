// Tests for the 1D and 2D elliptic (Laplace/Poisson) solvers.
// Run with:  vanic test tests/test_laplace.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

fn main() -> i64 {
    // pde_laplace1d_assemble/pde_laplace1d_rhs directly: n=4, dx=0.5
    // (inv_dx2=4.0), hand-derived exact matrix/vector entries. Had no
    // direct call site of their own -- only exercised transitively
    // inside pde_laplace1d_solve below.
    let A4: Vec<f64> = pde_laplace1d_assemble(4, 0.5);
    // Row 0 and row 3 (n-1) are identity rows (Dirichlet).
    assert close(A4[0 * 4 + 0], 1.0);
    assert close(A4[0 * 4 + 1], 0.0);
    assert close(A4[3 * 4 + 3], 1.0);
    assert close(A4[3 * 4 + 0], 0.0);
    // Row 1 (interior): [1,-2,1]/dx^2 stencil at columns 0,1,2.
    assert close(A4[1 * 4 + 0], 4.0);
    assert close(A4[1 * 4 + 1], 0.0 - 8.0);
    assert close(A4[1 * 4 + 2], 4.0);
    assert close(A4[1 * 4 + 3], 0.0);
    // Row 2 (interior): stencil at columns 1,2,3.
    assert close(A4[2 * 4 + 1], 4.0);
    assert close(A4[2 * 4 + 2], 0.0 - 8.0);
    assert close(A4[2 * 4 + 3], 4.0);
    assert close(A4[2 * 4 + 0], 0.0);

    let f4: Vec<f64> = vec(999.0, 3.0, 5.0, 999.0); // f[0]/f[3] ignored (Dirichlet rows)
    let b4: Vec<f64> = pde_laplace1d_rhs(4, ref f4, 7.0, 9.0);
    assert close(b4[0], 7.0);
    assert close(b4[1], 3.0);
    assert close(b4[2], 5.0);
    assert close(b4[3], 9.0);

    // pde_laplace2d_assemble/pde_laplace2d_rhs directly: nx=ny=3, dx=dy=1
    // (inv_dx2=inv_dy2=1.0). Had no direct call site of their own --
    // only exercised transitively inside pde_laplace2d_solve below.
    let A9: Vec<f64> = pde_laplace2d_assemble(3, 3, 1.0, 1.0);
    let N9: i64 = 9;
    // Border rows (every row except the single interior point (1,1),
    // idx=4) are identity rows.
    assert close(A9[0 * N9 + 0], 1.0);
    assert close(A9[8 * N9 + 8], 1.0);
    assert close(A9[2 * N9 + 2], 1.0);
    assert close(A9[6 * N9 + 6], 1.0);
    // Row 4 (interior, i=1,j=1): 5-point stencil. west=idx(0,1)=1,
    // east=idx(2,1)=7, south=idx(1,0)=3, north=idx(1,2)=5.
    assert close(A9[4 * N9 + 1], 1.0);
    assert close(A9[4 * N9 + 7], 1.0);
    assert close(A9[4 * N9 + 3], 1.0);
    assert close(A9[4 * N9 + 5], 1.0);
    assert close(A9[4 * N9 + 4], 0.0 - 4.0);

    let f9: Vec<f64> = vec(0.0, 0.0, 0.0, 0.0, 42.0, 0.0, 0.0, 0.0, 0.0);
    let boundary9: Vec<f64> = vec(10.0, 20.0, 30.0, 40.0, 999.0, 50.0, 60.0, 70.0, 80.0);
    let b9: Vec<f64> = pde_laplace2d_rhs(3, 3, ref f9, ref boundary9);
    assert close(b9[0], 10.0);
    assert close(b9[1], 20.0);
    assert close(b9[2], 30.0);
    assert close(b9[3], 40.0);
    assert close(b9[4], 42.0); // interior: from f, not boundary
    assert close(b9[5], 50.0);
    assert close(b9[6], 60.0);
    assert close(b9[7], 70.0);
    assert close(b9[8], 80.0);

    // 1D: u'' = -2 on [0,1], u(0)=0, u(1)=0. Exact: u(x) = x - x^2.
    let n: i64 = 11;
    let dx: f64 = 1.0 / ((n - 1) as f64);
    let f: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n {
        push(mut ref f, 0.0 - 2.0);
        i = i + 1;
    }
    let u: Vec<f64> = pde_laplace1d_solve(n, dx, ref f, 0.0, 0.0);
    i = 0;
    while i < n {
        let x: f64 = (i as f64) * dx;
        let exact: f64 = x - x * x;
        assert close(u[i], exact);
        i = i + 1;
    }

    // 2D: u(x,y) = x^2 - y^2 is harmonic (u_xx + u_yy = 0). f=0 everywhere;
    // boundary is the exact solution on the border. The 5-point Laplacian is
    // exact for quadratics, so the interior must match exactly too -- not
    // just approximately, a strong composed correctness check.
    let nx: i64 = 5;
    let ny: i64 = 5;
    let dxv: f64 = 1.0 / ((nx - 1) as f64);
    let dyv: f64 = 1.0 / ((ny - 1) as f64);
    let N: i64 = nx * ny;
    let f2: Vec<f64> = vec();
    let boundary: Vec<f64> = vec();
    i = 0;
    while i < N {
        push(mut ref f2, 0.0);
        push(mut ref boundary, 0.0);
        i = i + 1;
    }
    let ii: i64 = 0;
    while ii < nx {
        let jj: i64 = 0;
        while jj < ny {
            let x: f64 = (ii as f64) * dxv;
            let y: f64 = (jj as f64) * dyv;
            let idx: i64 = pde_grid2d_index(ii, jj, ny);
            set(mut ref boundary, idx, x * x - y * y);
            jj = jj + 1;
        }
        ii = ii + 1;
    }
    let u2: Vec<f64> = pde_laplace2d_solve(nx, ny, dxv, dyv, ref f2, ref boundary);
    ii = 0;
    while ii < nx {
        let jj: i64 = 0;
        while jj < ny {
            let x: f64 = (ii as f64) * dxv;
            let y: f64 = (jj as f64) * dyv;
            let idx: i64 = pde_grid2d_index(ii, jj, ny);
            let exact: f64 = x * x - y * y;
            assert close(u2[idx], exact);
            jj = jj + 1;
        }
        ii = ii + 1;
    }

    return 0;
}
